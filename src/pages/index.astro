---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import WorkRow from '@/components/WorkRow.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { SITE } from '@/site.config';

const allWork = await getCollection('work', ({ data }) => !data.draft);
const sorted = [...allWork].sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const selected = sorted.slice(0, 5);
---

<BaseLayout title={SITE.name}>


<!-- Hero -->

<section class="mx-auto max-w-6xl px-6 pt-16 pb-20 sm:pt-24">

  <div class="flex items-center justify-between gap-16">


    <div class="max-w-3xl">


      <p class="text-ink-soft mb-6 inline-flex items-center gap-2 font-mono text-lg">
        <span class="bg-signal h-1.5 w-1.5 rounded-full"></span>
        {SITE.status}
      </p>



      <h1 class="font-display text-ink max-w-3xl text-5xl leading-[1.15] font-medium">
        Research in artificial intelligence, big data,
        and intelligent manufacturing.
      </h1>



      <p class="text-ink-soft mt-6 max-w-2xl text-xl">
        PhD Candidate in Mechanical Engineering at Northwestern Polytechnical University,
        researching large language models, AI agents, big data, and intelligent manufacturing.
      </p>



      <div class="mt-8 flex flex-wrap items-center gap-3">

        <Button href="/work" variant="solid">
          View Publications →
        </Button>


        <Button href="#contact" variant="ghost">
          Contact →
        </Button>

      </div>


    </div>



    <img
      src="/profile.png"
      alt="Yuntong Chen"
      class="hidden h-48 w-40 border border-line object-contain lg:block"
    />


  </div>


</section>





<!-- Education -->

<section id="education" class="mx-auto max-w-6xl px-6 pb-20">


<SectionHeading eyebrow="Education" />



<div class="space-y-10 text-xl">


  <div class="grid grid-cols-[1.3fr_1.8fr_auto] items-start gap-8">

    <strong class="text-ink">
      Northwestern Polytechnical University
    </strong>

    <span class="text-ink-soft">
      PhD Candidate in Mechanical Engineering
    </span>

    <span class="text-ink-soft font-mono text-base whitespace-nowrap">
      2024 – 2027 (Expected)
    </span>

  </div>



  <div class="grid grid-cols-[1.3fr_1.8fr_auto] items-start gap-8">

    <strong class="text-ink">
      Northwestern Polytechnical University
    </strong>

    <span class="text-ink-soft">
      M.Eng. in Mechanical Engineering
    </span>

    <span class="text-ink-soft font-mono text-base whitespace-nowrap">
      2023 – 2024
    </span>

  </div>



  <div class="grid grid-cols-[1.3fr_1.8fr_auto] items-start gap-8">

    <strong class="text-ink">
      Southwest University
    </strong>

    <span class="text-ink-soft">
      B.Eng. in Mechanical Design, Manufacturing and Automation
    </span>

    <span class="text-ink-soft font-mono text-base whitespace-nowrap">
      2019 – 2023
    </span>

  </div>


</div>


</section>





<!-- Publications -->

<section id="publications" class="mx-auto max-w-6xl px-6 pb-20">


<SectionHeading eyebrow="Publications" count={allWork.length} />



<div>

{selected.map((entry) => <WorkRow entry={entry} />)}

</div>



{
allWork.length > selected.length && (

<div class="mt-6">


<a
href="/work"
class="text-ink-soft hover:text-signal font-mono text-sm transition-colors"
>

View all publications →

</a>


</div>

)
}


</section>






<!-- Contact -->

<section id="contact" class="mx-auto max-w-6xl px-6 pb-24">


<SectionHeading eyebrow="Contact" />



<p class="font-display text-ink max-w-2xl text-3xl sm:text-4xl">

Interested in research collaboration?

</p>



<div class="mt-4 flex flex-col gap-3">



<a
href={`mailto:${SITE.email}`}
class="text-signal font-mono text-lg hover:underline"
>
{SITE.email}
</a>



<a
href="https://scholar.google.com/citations?user=uozho7EAAAAJ&hl=en"
class="text-signal font-mono text-lg hover:underline"
>
Google Scholar
</a>



<a
href="https://orcid.org/0009-0001-5050-5395"
class="text-signal font-mono text-lg hover:underline"
>
ORCID
</a>



<a
href="https://github.com/aeon666-cyt"
class="text-signal font-mono text-lg hover:underline"
>
GitHub
</a>



</div>


</section>


</BaseLayout>
