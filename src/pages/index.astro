---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import WorkRow from '@/components/WorkRow.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { SITE } from '@/site.config';

const allWork = await getCollection('work', ({ data }) => !data.draft);
const sorted = [...allWork].sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const selected = sorted.slice(0, 5);
---

<BaseLayout title={SITE.name}>

  <!-- Hero -->
  <section class="mx-auto max-w-3xl px-6 pt-16 pb-20 sm:pt-24">

    <p class="text-ink-soft mb-6 inline-flex items-center gap-2 font-mono text-xs">
      <span class="bg-signal h-1.5 w-1.5 rounded-full" aria-hidden="true"></span>
      {SITE.status}
    </p>

    <h1 class="font-display text-ink max-w-2xl text-4xl leading-[1.1] font-medium sm:text-5xl">
      {SITE.tagline}
    </h1>

    <p class="text-ink-soft mt-6 max-w-md">
      PhD Candidate in Mechanical Engineering at Northwestern Polytechnical University,
      focusing on large language models, AI agents, big data, and intelligent manufacturing.
    </p>


    <div class="mt-8 flex flex-wrap items-center gap-3">
      <Button href="/work" variant="solid">
        View Publications →
      </Button>

      <Button href="#contact" variant="ghost">
        Contact →
      </Button>
    </div>

  </section>


  <!-- Publications -->
  <section id="work" class="mx-auto max-w-3xl px-6 pb-20">

    <SectionHeading eyebrow="Publications" count={allWork.length} />

    <div>
      {selected.map((entry) => <WorkRow entry={entry} />)}
    </div>

    {
      allWork.length > selected.length && (
        <div class="mt-6">
          <a
            href="/work"
            class="text-ink-soft hover:text-signal font-mono text-xs transition-colors"
          >
            View all publications →
          </a>
        </div>
      )
    }

  </section>



  <!-- Education -->
  <section id="about" class="mx-auto max-w-3xl px-6 pb-20">

    <SectionHeading eyebrow="Education" />

    <p class="text-ink-soft max-w-xl">

      <strong>
        Northwestern Polytechnical University
      </strong>
      <br />
      PhD Candidate in Mechanical Engineering
      <br />
      2024 – 2027 (Expected)

      <br /><br />

      <strong>
        Northwestern Polytechnical University
      </strong>
      <br />
      M.Eng. in Mechanical Engineering
      <br />
      2023 – 2024

      <br /><br />

      <strong>
        Southwest University
      </strong>
      <br />
      B.Eng. in Mechanical Design, Manufacturing and Automation
      <br />
      2019 – 2023

    </p>

  </section>



  <!-- Contact -->
  <section id="contact" class="mx-auto max-w-3xl px-6 pb-24">

    <SectionHeading eyebrow="Contact" />

    <p class="font-display text-ink max-w-lg text-2xl sm:text-3xl">
      Interested in research collaboration?
    </p>

    <a
      href={`mailto:${SITE.email}`}
      class="text-signal mt-4 inline-flex items-center gap-2 font-mono hover:underline"
    >
      {SITE.email}
    </a>

  </section>


</BaseLayout>
