---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'work'>;
}

const { entry } = Astro.props;

const { title, summary, date, tags } = entry.data;

const stamp = date.getFullYear();
---

<a
  href={`/work/${entry.id}`}
  class="group border-line hover:border-signal grid grid-cols-[4.5rem_1fr_auto] items-center gap-4 border-b py-6 transition-colors sm:grid-cols-[5.5rem_1fr_auto] sm:gap-6"
>

  <!-- Year -->
  <span class="text-ink-soft font-mono text-base">
    {stamp}
  </span>


  <!-- Publication -->
  <span class="min-w-0">

    <span
      class="font-display text-ink group-hover:text-signal block truncate text-xl transition-colors"
    >
      {title}
    </span>


    <span class="text-ink-soft hidden truncate text-base sm:block">
      {summary}
    </span>

  </span>



  <!-- Tags -->
  <span class="flex items-center gap-4">


    <span class="text-ink-soft hidden font-mono text-xs md:block">
      {tags.slice(0, 2).join(' · ')}
    </span>


    <span
      aria-hidden="true"
      class="text-ink-soft group-hover:text-signal transition-all group-hover:translate-x-1"
    >
      →
    </span>


  </span>


</a>
